# Kopiraj u .env i popuni.

# DeepSeek API (OpenAI-kompatibilan endpoint). Kljuc nikad ne ide u git.
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
MODEL=deepseek-flash
# disabled ili enabled
THINKING=disabled

# SEC trazi User-Agent sa kontaktom: "Ime Prezime email@domen.com"
SEC_USER_AGENT=
