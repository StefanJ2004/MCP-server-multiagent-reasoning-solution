# Kopiraj u .env i popuni. Kljuc nikad ne ide u git (repo je javan).

# OpenRouter, DeepSeek V4.1 Flash, zakucan na Alibaba Cloud provajdera (bez prebacivanja na druge)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_PROVIDER=alibaba
# disabled ili enabled
THINKING=disabled

# Alternativa: DeepSeek API direktno (OPENROUTER_PROVIDER se tada ignorise)
# OPENAI_BASE_URL=https://api.deepseek.com
# MODEL=deepseek-flash

# SEC trazi User-Agent sa kontaktom: "Ime Prezime email@domen.com"
SEC_USER_AGENT=
